<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>AddServlet</servlet-name>
        <servlet-class>za.ac.tut.web.AddServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetTestStatisticsServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetTestStatisticsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetStudentUsingServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetStudentUsingServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetStudentUsingNameSurname</servlet-name>
        <servlet-class>za.ac.tut.web.GetStudentUsingNameSurname</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetStudentUsingAgeServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetStudentUsingAgeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddServlet</servlet-name>
        <url-pattern>/AddServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetTestStatisticsServlet</servlet-name>
        <url-pattern>/GetTestStatisticsServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetStudentUsingServlet</servlet-name>
        <url-pattern>/GetStudentUsingServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetStudentUsingNameSurname</servlet-name>
        <url-pattern>/GetStudentUsingNameSurname.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetStudentUsingAgeServlet</servlet-name>
        <url-pattern>/GetStudentUsingAgeServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
